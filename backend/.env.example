# Copy to backend/.env and fill in. Never commit .env.
OPEN_ROUTER_KEY=
# Any OpenRouter model id; DeepSeek is the default.
AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
# JSON list of browser origins allowed to call the API directly (the Vite proxy doesn't need this).
# CORS_ORIGINS=["http://localhost:5173"]

# --- barista (POST /v1/decide) and grinder (POST /v1/embed) ---
# Postgres for API keys and usage. Empty = those endpoints are off (chat still works).
# Local: `docker compose up -d` at the repo root, then `uv run bean migrate`.
DATABASE_URL=postgresql://bean:bean@localhost:5445/bean
# Bearer token for /v1/admin/*. Empty = admin endpoints off.
BARISTA_ADMIN_TOKEN=
# Comma-separated hostnames that only expose barista or grinder (never bean's chat API).
# BARISTA_HOSTS=barista.tailf9a785.ts.net
# GRINDER_HOSTS=grinder.tailf9a785.ts.net
# Whether /v1/decide, /v1/embed and /v1/usage also answer on bean's own host.
# GATEWAY_ON_BEAN_HOST=true
# Global monthly caps in USD (0 = no cap).
# BARISTA_MONTHLY_CAP_USD=20
# GRINDER_MONTHLY_CAP_USD=20
# Model allow-lists, comma-separated; the first is the default.
# BARISTA_MODELS=perplexity/pplx-decider-flash-v1.2
# GRINDER_MODELS=qwen/qwen3-embedding-8b
# Defaults for new keys.
# DEFAULT_RPM=30
# DEFAULT_MAX_TOKENS_PER_REQUEST=8000
# DEFAULT_MONTHLY_BUDGET_USD=1
# Provider data-collection preference forced onto every upstream request ("" = don't send one).
# OPENROUTER_DATA_COLLECTION=deny
