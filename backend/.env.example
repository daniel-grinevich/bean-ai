# Copy to backend/.env and fill in. Never commit .env.
# Each key enables that provider's models in models.yaml; the server starts without either.
ANTHROPIC_API_KEY=
OPEN_ROUTER_KEY=
# Optional: another models file (default: models.yaml in the working directory).
# MODELS_FILE=models.yaml
# Optional: override the default model from models.yaml (must be one of its enabled ids).
# AGENT_MODEL=claude-sonnet-5
# JSON list of browser origins allowed to call the API directly (the Vite proxy doesn't need this).
# CORS_ORIGINS=["http://localhost:5173"]
