# Copy to backend/.env and fill in. Never commit .env.
# Each key enables that provider's models in models.yaml; the server starts without either.
ANTHROPIC_API_KEY=
OPEN_ROUTER_KEY=
# Optional: another models file (default: models.yaml in the working directory).
# MODELS_FILE=models.yaml
# Optional: override the default model from models.yaml (must be one of its enabled ids).
# AGENT_MODEL=claude-sonnet-5
# Optional: override the default agent from agents.yaml, e.g. to chat with Senior Dev Daniel locally.
# DEFAULT_AGENT=senior-dev-daniel
# Trace collector (OTLP over HTTP), e.g. a local Phoenix. Unset = no traces are sent (the server
# warns once at startup). /v1/traces is appended.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006
# Phoenix API key, sent as `Authorization: Bearer <key>`; only needed when Phoenix has auth on.
# PHOENIX_API_KEY=
# Where this server runs: local, staging or production. Tags every trace.
# ENVIRONMENT=local
# JSON list of browser origins allowed to call the API directly (the Vite proxy doesn't need this).
# CORS_ORIGINS=["http://localhost:5173"]
