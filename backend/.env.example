# Copy to backend/.env and fill in. Never commit .env.
OPEN_ROUTER_KEY=
# Any OpenRouter model id; DeepSeek is the default.
AGENT_MODEL=deepseek/deepseek-v4.1-flash-1017
# JSON list of browser origins allowed to call the API directly (the Vite proxy doesn't need this).
# CORS_ORIGINS=["http://localhost:5173"]
